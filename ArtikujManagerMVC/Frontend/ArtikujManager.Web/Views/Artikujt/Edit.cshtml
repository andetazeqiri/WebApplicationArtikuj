@model ArtikujManager.Web.Models.CreateArtikujViewModel

@{
    ViewData["Title"] = "Përditëso Artikull";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">
                    <i class="fas fa-edit me-2 text-warning"></i>
                    Përditëso Artikull
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Emri" class="form-label required"></label>
                                <input asp-for="Emri" class="form-control" placeholder="Shkruani emrin e artikullit" />
                                <span asp-validation-for="Emri" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Barkodi" class="form-label"></label>
                                <input asp-for="Barkodi" class="form-control" placeholder="Shkruani barkodin" />
                                <span asp-validation-for="Barkodi" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="Cmimi" class="form-label required"></label>
                                <div class="input-group">
                                    <span class="input-group-text">€</span>
                                    <input asp-for="Cmimi" class="form-control" step="0.01" min="0" 
                                           placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Cmimi" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="Njesia" class="form-label"></label>
                                <input asp-for="Njesia" class="form-control" placeholder="p.sh. Kg, Litra, Copë" />
                                <span asp-validation-for="Njesia" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label asp-for="DataSkadences" class="form-label">Data e Skadences</label>
                                <input asp-for="DataSkadences" class="form-control" type="date" />
                                <span asp-validation-for="DataSkadences" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="form-label">Lloj</label>
                                <div class="mt-2">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" asp-for="Lloj" value="Importuar" id="llojImportuar" />
                                        <label class="form-check-label" for="llojImportuar">
                                            Importuar
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" asp-for="Lloj" value="Vendi" id="llojVendi" />
                                        <label class="form-check-label" for="llojVendi">
                                            Vendi
                                        </label>
                                    </div>
                                </div>
                                <span asp-validation-for="Lloj" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <div class="form-check">
                                    <input asp-for="KaTvsh" class="form-check-input" type="checkbox" id="katvsh-checkbox" />
                                    <label class="form-check-label" for="katvsh-checkbox">
                                        Ka TVSH (Po/Jo)
                                    </label>
                                </div>
                                
                                <span asp-validation-for="KaTvsh" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Tipi" class="form-label">Tipi</label>
                        <select asp-for="Tipi" class="form-select">
                            <option value="">-- Zgjidhni tipin --</option>
                            <option value="Ushqimor">Ushqimor</option>
                            <option value="Bulmet">Bulmet</option>
                            <option value="Pije">Pije</option>
                            <option value="Embelsire">Embelsire</option>
                        </select>
                        <span asp-validation-for="Tipi" class="text-danger small"></span>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>
                            Kthehu te Lista
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save me-1"></i>
                            Përditëso Artikullin
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <style>
        .form-label.required::after {
            content: " *";
            color: red;
        }
    </style>
}