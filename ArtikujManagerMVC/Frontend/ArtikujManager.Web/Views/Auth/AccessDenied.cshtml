@{
    ViewData["Title"] = "Aksesi u Refuzua";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Aksesi u Refuzua
                </h4>
            </div>
            <div class="card-body text-center">
                <p class="lead mb-3">Nuk keni  akses </p>
                <p class="text-muted">
                    Kontaktoni administratorin 
                </p>
                
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">
                        <i class="fas fa-home me-1"></i>
                        Kthehuni ne faqen kryesore
                    </a>
                    <a asp-action="Login" class="btn btn-secondary">
                        <i class="fas fa-sign-in-alt me-1"></i>
                        Log In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>