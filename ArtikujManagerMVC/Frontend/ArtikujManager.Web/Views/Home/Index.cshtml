@{
    ViewData["Title"] = "Home";
}

<div class="jumbotron bg-primary text-white rounded p-5 mb-4">
    <div class="container">
        <h1 class="display-4 fw-bold">
            <i class="fas fa-boxes me-3"></i>
            Mirë se vini në ArtikujManager
        </h1>
        <p class="lead">Sistem  per menaxhimin e artikujve </p>
        
        @if (ViewBag.IsAuthenticated == true)
        {
            <div class="d-flex align-items-center mt-4">
                <div class="me-4">
                    <i class="fas fa-user-circle fa-3x"></i>
                </div>
                <div>
                    <h5 class="mb-1">Mire se erdhe, @ViewBag.UserName!</h5>
                    <p class="mb-0">
                        Roli: 
                        <span class="badge @(ViewBag.UserRole == "Admin" ? "bg-warning text-dark" : "bg-info")">
                            @(ViewBag.UserRole == "Admin" ? "Administrator" : ViewBag.UserRole == "Operator" ? "Operator" : ViewBag.UserRole)
                        </span>
                    </p>
                </div>
            </div>
        }
    </div>
</div>

@if (ViewBag.IsAuthenticated == true)
{
   
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-list fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Shiko Artikujt</h5>
                    <p class="card-text">Shikoni dhe menaxhoni të gjithe artikujt ne sistem.</p>
                    <a asp-controller="Artikujt" asp-action="Index" class="btn btn-primary">
                        <i class="fas fa-arrow-right me-1"></i>
                        Hyr
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-plus-circle fa-3x text-success mb-3"></i>
                    <h5 class="card-title">Shto Artikull</h5>
                    <p class="card-text">Shtoni artikuj te rinj ne inventarin tuaj.</p>
                    <a asp-controller="Artikujt" asp-action="Create" class="btn btn-success">
                        <i class="fas fa-plus me-1"></i>
                        Shto
                    </a>
                </div>
            </div>
        </div>
    </div>
    
   
}
else
{
  
    <div class="row">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-sign-in-alt fa-4x text-primary mb-3"></i>
                    <h4 class="card-title">Log In to System</h4>
                    <p class="card-text">Log in to access the article management system.</p>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-lg">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        Log In Now
                    </a>
                    
                  
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-user-plus fa-4x text-success mb-3"></i>
                    <h4 class="card-title">Krijoni nje Llogari</h4>
                    <p class="card-text">Regjistrohuni për të krijuar një llogari të re dhe për të filluar menaxhimin e artikujve tuaj.</p>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-success btn-lg">
                        <i class="fas fa-user-plus me-2"></i>
                        Regjistrohuni
                    </a>
                    
                    
                </div>
            </div>
        </div>
    </div>
    
   
    
}




